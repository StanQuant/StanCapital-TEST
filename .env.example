# Stance Capital 環境變數範本
# 複製成 .env 後填入真實值。.env 已被 .gitignore 排除，禁止 commit(ClaudeC §3.3)。

# L5 PostgreSQL(S02)— 本機測試庫的預設值(非真密碼)，生產環境換成真實連線字串
DATABASE_URL=postgresql+asyncpg://stanquant:change-me-local-dev-only@localhost:5433/stanquant_test  # pragma: allowlist secret

# L4 EventBus Redis(S03)— 本機測試用 6380(compose 對應)，生產環境換真實位址
REDIS_URL=redis://localhost:6380/0
